# ==============================================================================
# SwasthaAI — Environment Variables (Layers 0, 1, 2)
# Copy this file to .env and fill in real values before running.
# NEVER commit .env to version control.
# ==============================================================================

# ── Application ────────────────────────────────────────────────────────────────
# Secret key used for internal signing (not Keycloak). Use a 64+ char random string.
SECRET_KEY=change_me_to_a_very_long_random_secret_key_at_least_64_chars

# Application environment: development | staging | production
ENVIRONMENT=development

# Logging level: DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO

# ── Supabase (PostgreSQL) ───────────────────────────────────────────────────────
# Get all of these from: Supabase Dashboard → Project Settings → Database
#
# DATABASE_URL  — used by the FastAPI app at runtime.
#   Use the TRANSACTION POOLER (port 6543) for async connections via asyncpg.
#   Format: postgresql+asyncpg://[user].[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql+asyncpg://postgres.[PROJECT-REF]:[DB-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres

# ALEMBIC_DATABASE_URL — used ONLY by Alembic migrations (alembic upgrade head).
#   Use the DIRECT CONNECTION (port 5432) — pooler does not support DDL migrations.
#   Format: postgresql+asyncpg://postgres.[project-ref]:[password]@db.[project-ref].supabase.co:5432/postgres
ALEMBIC_DATABASE_URL=postgresql+asyncpg://postgres.[PROJECT-REF]:[DB-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres

# Supabase project reference (e.g. abcdefghijklmnop)
SUPABASE_PROJECT_REF=replace_with_your_project_ref

# Supabase service role key (server-side only — NEVER expose to frontend)
# Get from: Supabase Dashboard → Project Settings → API → service_role key
SUPABASE_SERVICE_ROLE_KEY=replace_with_your_service_role_key

# Supabase anon/public key (safe for unauthenticated read operations)
SUPABASE_ANON_KEY=replace_with_your_anon_key

# Supabase project URL (used by the supabase-py client if needed)
SUPABASE_URL=https://[PROJECT-REF].supabase.co

# ── MinIO Object Storage ────────────────────────────────────────────────────────
# MinIO host:port (no http:// prefix)
MINIO_ENDPOINT=localhost:9000

# MinIO root credentials (set same as MINIO_ROOT_USER/PASSWORD in docker-compose)
MINIO_ACCESS_KEY=swastha_ai_minio
MINIO_SECRET_KEY=swastha_ai_minio_secret

# Whether MinIO is served over TLS (false for local dev, true for production)
MINIO_USE_SSL=false

# Bucket name for raw (un-processed) document storage
MINIO_BUCKET_RAW=swastha-ai-raw-documents

# ── Apache Kafka ────────────────────────────────────────────────────────────────
# Comma-separated list of Kafka broker addresses
KAFKA_BOOTSTRAP_SERVERS=localhost:29092

# ── Redis ──────────────────────────────────────────────────────────────────────
# Redis connection URL — password must match redis-server --requirepass
REDIS_URL=redis://:swastha_ai_redis_secret@localhost:6379/0
REDIS_PASSWORD=swastha_ai_redis_secret

# ── Keycloak ───────────────────────────────────────────────────────────────────
# Base URL of the Keycloak instance (no trailing slash)
KEYCLOAK_URL=http://localhost:8080

# Realm name configured in Keycloak
KEYCLOAK_REALM=swastha-ai

# Client ID registered in Keycloak for this service
KEYCLOAK_CLIENT_ID=swastha-ai-api

# Keycloak admin credentials (used only in docker-compose, not by the app)
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=admin_secret

# ── Upload Limits ──────────────────────────────────────────────────────────────
# Maximum allowed upload size in megabytes
MAX_UPLOAD_SIZE_MB=100

# Comma-separated MIME types allowed for upload
ALLOWED_MIME_TYPES=application/pdf,application/vnd.openxmlformats-officedocument.wordprocessingml.document,application/xml,text/csv,application/json,application/zip

# ── Rate Limiting ──────────────────────────────────────────────────────────────
# Maximum requests per minute per IP address
RATE_LIMIT_PER_MINUTE=60

# Maximum requests per minute per authenticated user
RATE_LIMIT_USER_PER_MINUTE=20

# Rate limit for api_client role (more aggressive)
RATE_LIMIT_API_CLIENT_PER_MINUTE=30

# Comma-separated list of IP addresses that bypass rate limiting
RATE_LIMIT_WHITELIST=127.0.0.1,::1

# ── ClamAV Virus Scanning ──────────────────────────────────────────────────────
# ClamAV daemon host (leave empty to disable virus scanning in dev)
CLAMAV_HOST=

# ClamAV daemon port
CLAMAV_PORT=3310

# Alternatively, a webhook URL to POST file bytes to for virus scanning
VIRUS_SCAN_WEBHOOK_URL=

# ── API Keys (Machine-to-Machine) ─────────────────────────────────────────────
# Comma-separated list of valid API keys for portal-to-portal auth
# Format: key:role:description (e.g., abc123:api_client:sugam-portal)
API_KEYS=replace_with_real_api_key:api_client:sugam-portal

# ── Portal Adapters ────────────────────────────────────────────────────────────
# SUGAM portal REST API base URL
SUGAM_API_BASE_URL=https://sugam.cdsco.gov.in/api/v1

# SUGAM portal API key
SUGAM_API_KEY=replace_with_sugam_api_key

# MD Online portal REST API base URL
MD_ONLINE_API_BASE_URL=https://mdonline.cdsco.gov.in/api/v1

# MD Online portal API key
MD_ONLINE_API_KEY=replace_with_md_online_api_key

# Poll interval for adapters in seconds
ADAPTER_POLL_INTERVAL_SECONDS=60

# ==============================================================================
# SwasthaAI Layer 1 — Preprocessing Environment Variables
# ==============================================================================

# ── ChromaDB ───────────────────────────────────────────────────────────────────
# ChromaDB host and port for vector storage
CHROMA_HOST=localhost
CHROMA_PORT=8002

# ── Background Workers ─────────────────────────────────────────────────────────
# Enable the background consumer that runs the preprocessing pipeline
ENABLE_PREPROCESSOR=true

# Number of documents to batch when creating embeddings
EMBEDDING_BATCH_SIZE=32

# Max concurrency for heavy OCR tasks
OCR_CONCURRENCY=4

# ── Apache Tika ────────────────────────────────────────────────────────────────
# URL for the Tika server used to parse PDFs, Word docs, etc.
TIKA_SERVER_URL=http://localhost:9998

# ==============================================================================
# SwasthaAI Layer 2 — Message Bus Environment Variables
# ==============================================================================

# ── Confluent Schema Registry ──────────────────────────────────────────────────
# Base URL for the Avro schema registry
SCHEMA_REGISTRY_URL=http://localhost:8081

# ── Resilience ─────────────────────────────────────────────────────────────────
# Fallback log path if the Redis buffer is full and a Kafka broker is completely unreachable
KAFKA_FALLBACK_LOG=/tmp/kafka_fallback.jsonl

# ==============================================================================
# SwasthaAI Layer 3 - AI Core Environment Variables
# ==============================================================================

# Enable anonymisation, summarisation, classification, and comparison workers
ENABLE_AI_CORE=true

# offline = deterministic local modules only, hybrid = local first with LLM hooks,
# cloud = external LLM primary where configured
AI_CORE_MODEL_MODE=offline

# Optional Claude integration for future cloud/hybrid summaries and narration
ANTHROPIC_API_KEY=

# Ollama fallback for on-prem/offline Stage 2 deployments
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b

# Shared processed artefact bucket for Layer 1 and Layer 3 JSON outputs
AI_CORE_PROCESSED_BUCKET=swastha-ai-processed-documents

# ==============================================================================
# SwasthaAI Layer 4 - Compliance and Governance Environment Variables
# ==============================================================================

# Enable DPDP/ICMR/NDHM governance checks and XAI decision logging
ENABLE_COMPLIANCE=true

